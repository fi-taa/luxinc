# Supabase — Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only (seed scripts, admin bypass). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Chapa payments (server-only secret)
NEXT_PUBLIC_APP_URL=http://localhost:3000
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key
# CHAPA_WEBHOOK_SECRET=optional

# Google Search Console (URL prefix property — HTML tag method)
# Paste only the content value, not the full meta tag
# GOOGLE_SITE_VERIFICATION=your_verification_code

# Vercel: Project → Settings → Environment Variables
# Add the same values for Production (and Preview if needed), then redeploy.
# NEXT_PUBLIC_APP_URL must be your live site URL, e.g. https://luxinc.vercel.app
